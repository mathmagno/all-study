# Template de configuração SSH para AWS Lightsail
# Copie para ~/.ssh/config (Windows: C:\Users\SEU_USUARIO\.ssh\config)
# e ajuste o caminho da IdentityFile para a sua máquina.

Host lightsail
  HostName 54.20.4.21
  User ubuntu
  IdentityFile "C:\Users\SEU_USUARIO\OneDrive\Documentos\GitHub\go_definitve\LightsailDefaultKey-sa-east-1.pem"

# Alternativa: chave na pasta .ssh do usuário
# Host lightsail
#   HostName 54.20.4.21
#   User ubuntu
#   IdentityFile "C:\Users\SEU_USUARIO\.ssh\LightsailDefaultKey-sa-east-1.pem"
